{
  "name": "note-next",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint . && echo \"ESLint run success: No errors found.\"",
    "format": "prettier --write \"{app,components}/**/*.{ts,tsx}\"",
    "db:check": "dotenv -e .env.local -- drizzle-kit check",
    "db:gen": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed": "dotenv -e .env.local -- tsx db/seed.ts",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio --port 5555 --verbose",
    "db:prod:check": "drizzle-kit check",
    "db:prod:gen": "drizzle-kit generate",
    "db:prod:migrate": "dotenv -e .env.production -- drizzle-kit migrate",
    "test:notes": "node --conditions=react-server --import tsx --test scripts/note-recovery.test.ts scripts/note-mutation.test.ts scripts/note-cleanup.test.ts",
    "db:audit:notes": "node --import tsx scripts/note-recovery-audit.ts",
    "test:notes:http": "node --conditions=react-server --import tsx --test scripts/note-recovery-http.test.ts",
    "test:notes:cleanup:http": "node --conditions=react-server --import tsx --test scripts/note-cleanup-http.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@ai-sdk/react": "^4.0.146",
    "@kaiverse/k": "^0.7.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@tiptap/extension-character-count": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@upstash/ratelimit": "^2.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.142",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@serwist/cli": "^9.5.13",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/eslint": "^9.6.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "postcss": "8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.13",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
