{
  "name": "note-next",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write \"{app,components}/**/*.{ts,tsx}\"",
    "db:check": "dotenv -e .env.local -- drizzle-kit check",
    "db:gen": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed": "dotenv -e .env.local -- ts-node db/seed.ts",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio --port 5555 --verbose",
    "db:prod:check": "drizzle-kit check",
    "db:prod:gen": "drizzle-kit generate",
    "db:prod:migrate": "dotenv -e .env.production -- drizzle-kit migrate"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@kaiverse/k": "^0.7.0",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/extension-character-count": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@upstash/ratelimit": "^2.0.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "@vercel/speed-insights": "^2.0.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.13.7",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zustand": "^4.3.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@serwist/cli": "^9.5.12",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/eslint": "^9.6.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.12",
    "tailwindcss": "4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}