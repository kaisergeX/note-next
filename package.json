{
  "name": "note-next",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write \"{app,components}/**/*.{ts,tsx}\"",
    "db:check": "dotenv -e .env.local -- drizzle-kit check --config drizzle-local.config.ts",
    "db:gen": "dotenv -e .env.local -- drizzle-kit generate --config drizzle-local.config.ts",
    "db:push": "dotenv -e .env.local -- drizzle-kit push --config drizzle-local.config.ts",
    "db:seed": "dotenv -e .env.local -- ts-node db/seed.ts",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate --config drizzle-local.config.ts",
    "db:drop-migration": "dotenv -e .env.local -- drizzle-kit drop --config drizzle-local.config.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio --port 5555 --verbose --config drizzle-local.config.ts",
    "db:prod:check": "drizzle-kit check",
    "db:prod:gen": "drizzle-kit generate",
    "db:prod:migrate": "dotenv -e .env.production -- drizzle-kit migrate"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@kaiverse/k": "^0.7.0",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/extension-character-count": "^2.14.0",
    "@tiptap/extension-highlight": "^2.14.0",
    "@tiptap/extension-placeholder": "^2.14.0",
    "@tiptap/pm": "^2.14.0",
    "@tiptap/react": "^2.14.0",
    "@tiptap/starter-kit": "^2.14.0",
    "@upstash/ratelimit": "^2.0.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.6.0",
    "@vercel/speed-insights": "^2.0.0",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.44.5",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "4.9.1",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zustand": "^4.3.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@serwist/cli": "^9.5.11",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/eslint": "^9.6.1",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.0",
    "eslint": "10.4.0",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "postcss": "8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "serwist": "^9.5.11",
    "tailwindcss": "4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "esbuild@<=0.24.2": ">=0.25.0",
      "diff@>=4.0.0 <4.0.4": ">=4.0.4",
      "markdown-it@>=13.0.0 <14.1.1": ">=14.1.1",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4"
    }
  }
}
