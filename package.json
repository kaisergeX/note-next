{
  "name": "note-next",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:account": "node --env-file=.env.local scripts/run-account-tests.mjs",
    "test:account:http": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/account-http.test.ts",
    "dev": "next dev",
    "build": "next build && serwist build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint . && echo \"ESLint run success: No errors found.\"",
    "format": "prettier --write \"{app,components}/**/*.{ts,tsx}\"",
    "db:check": "dotenv -e .env.local -- drizzle-kit check",
    "db:gen": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed": "dotenv -e .env.local -- tsx db/seed.ts",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio --port 5555 --verbose",
    "db:prod:check": "drizzle-kit check",
    "db:prod:gen": "drizzle-kit generate",
    "db:prod:migrate": "dotenv -e .env.production -- drizzle-kit migrate",
    "test:notes": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/note-recovery.test.ts scripts/note-mutation.test.ts scripts/note-cleanup.test.ts scripts/note-sync.test.ts scripts/note-save-queue.test.ts",
    "db:audit:notes": "node --import tsx scripts/note-recovery-audit.ts",
    "test:notes:http": "node --conditions=react-server --import tsx --test scripts/note-recovery-http.test.ts",
    "test:notes:cleanup:http": "node --conditions=react-server --import tsx --test scripts/note-cleanup-http.test.ts",
    "test:notes:sync": "node --conditions=react-server --import tsx --test scripts/note-sync.test.ts scripts/note-save-queue.test.ts scripts/note-diff.test.ts",
    "test:notes:autosave:http": "node --env-file=.env.local --conditions=react-server --import tsx --test scripts/note-autosave-http.test.ts",
    "test:notes:browser": "node --env-file=.env.local node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@ai-sdk/react": "^4.0.167",
    "@floating-ui/dom": "^1.8.0",
    "@kaiverse/k": "^0.7.0",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@upstash/ratelimit": "^2.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.0",
    "@vercel/speed-insights": "^2.1.0",
    "ai": "^7.0.163",
    "cn": "^0.5.2",
    "dayjs": "^1.11.23",
    "dexie": "4.4.7",
    "diff": "^9.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@playwright/test": "^1.65.0",
    "@serwist/cli": "^9.5.13",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/eslint": "^9.6.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "postcss": "8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.13",
    "tailwindcss": "4.3.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
