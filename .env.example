SERVICE_NAME=
SERVICE_SHORTNAME=

# Next Auth
# If you deploy your app to Vercel, no need to set NEXTAUTH_URL environment on Vercel
NEXTAUTH_URL="http://localhost:3000"
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET=

# Next Auth Discord Provider
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Next Auth Google Provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DB
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=

# Optional: only for test:notes and test:notes:cleanup:http, not dev/build/deployment.
# Leave unset on Vercel. Use a disposable loopback database with _test in its name.
# Never point this at the app or production database.
NOTES_TEST_DATABASE_URL=

# Vercel cron Authorization Bearer secret; set in the production project before deploying.
# Generate with: openssl rand -hex 32. Never prefix with NEXT_PUBLIC_.
CRON_SECRET=

KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# AI / LM Studio (feeds config/ai.ts; LM Studio via Tailscale Funnel, key is server-side only)
LM_STUDIO_ENDPOINT=
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=
